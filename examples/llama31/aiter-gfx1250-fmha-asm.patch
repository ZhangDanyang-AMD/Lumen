@@ -2400,0 +2401,21 @@ def can_impl_fmha_v3_bwd(
+    def gfx1250():
+        # gfx1250 ships dedicated FMHA v3 assembly for the Llama/Qwen training
+        # shape. The code objects support BF16 hdim=128 in batch/group mode,
+        # atomic-f32 dQ accumulation, no bias/dropout, and no-mask or causal
+        # masks. Unlike the gfx942 path, deterministic mode is supported.
+        ret = get_gfx() == "gfx1250"
+        ret &= q.dtype == torch.bfloat16
+        ret &= hdim_q == 128 and hdim_v == 128
+        ret &= is_v3_atomic_fp32 == True
+        ret &= alibi_slopes is None
+        ret &= bias is None
+        ret &= dbias is None
+        ret &= dropout_p == 0.0
+        ret &= nhead_q % nhead_k == 0
+        ret &= nmask or mask
+        ret &= not swa
+        return ret
+
+    if gfx1250():
+        return True
+
