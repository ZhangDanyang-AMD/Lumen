FROM lumen/llama2:latest

WORKDIR /workspace/Lumen
COPY lumen/ lumen/
COPY examples/llama2/ examples/llama2/
COPY third_party/aiter/ /opt/lumen-aiter/

# Old Python overlays leave incompatible prebuilt extensions behind.
RUN pip uninstall -y aiter && rm -rf /opt/aiter && \
    mv /opt/lumen-aiter /opt/aiter && \
    cd /opt/aiter && PREBUILD_KERNELS=1 pip install -e .
